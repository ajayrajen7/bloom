{
  "name": "bloom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite runtime",
    "build": "vite build runtime",
    "generate": "node --env-file=.env.local --import tsx/esm generation/generate-cli.ts",
    "new-concept": "node --env-file=.env.local --import tsx/esm concepts/new-concept.ts",
    "review": "node --env-file=.env.local --import tsx/esm generation/review-ui/serve.ts",
    "eval": "node --env-file=.env.local --import tsx/esm generation/evals/runner.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vite": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "openai": "^4.0.0",
    "zod": "^3.23.0",
    "js-yaml": "^4.1.0",
    "commander": "^12.0.0",
    "phaser": "^3.80.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
