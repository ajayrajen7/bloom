flowchart TB
    subgraph FACTORY["PLANE A — CONTENT FACTORY (build-time, shared)"]
        A1["A1 Development Framework<br/>V1.1: static doc"]:::stub
        A2["A2 Concept Layer<br/>V1.1: in prompts"]:::stub
        A3["A3 Mechanics Registry<br/>V1.1: tap-one + find-all"]:::built
        A4["A4 Story/Theme Engine<br/>V1.1: no arcs; limited backdrops if needed"]:::thin
        A5["A5 Asset Registry<br/>AI sheets + style reference + normalization<br/>V1.1: bounded pilot first"]:::built
        A6["A6 Generation Layer<br/>V1.1: extend existing pipeline for 2 mechanics"]:::built
        G1{{"QA gates<br/>asset curation + evals + rendered review<br/>human review of both activities"}}:::gate
        A8[("A8 Content Library<br/>approved shared assets + playable activity specs<br/>no child-specific slots")]:::built

        A1 --> A2
        A2 -- constrains --> A3
        A2 --> A6
        A3 --> A6
        A4 --> A6
        A5 -- manifest --> A6
        A6 --> G1 --> A8
    end

    subgraph DIST["PLANE B — DISTRIBUTION (future personalization)"]
        B1["B1 Pack Builder<br/>future slot resolution + per-child pack<br/>V1.1: deferred"]:::stub
        G2{{"future automated pack gate"}}:::gate
    end

    subgraph RUNTIME["PLANE C — RUNTIME (child-facing, zero AI)"]
        C1[("C1 Child Context<br/>PRIVACY CORE<br/>V1.1: absent; no profile data")]:::stub
        C2["C2 Selection Engine<br/>V1.1: parent picks"]:::stub
        C3["C3 Child Runtime<br/>Phaser PWA, tablet-first<br/>V1.1: render and test both mechanics"]:::built
        C4["C4 Assessment & Profile<br/>THE MOAT<br/>V1.1: session record + parent notes"]:::thin
        C5["C5 Parent Surface<br/>V1.1: absent"]:::stub
    end

    A8 --> C3
    A8 -. end-state: selected specs .-> B1
    C1 -. resolved only at future pack build .-> B1
    B1 --> G2 -- future per-child pack --> C3
    C3 -- telemetry / notes --> C4
    C4 --> C2
    C1 --> C2
    A1 --> C2
    C2 -. end-state: selects specs .-> B1
    C4 -. progress narrative .-> C5
    C5 -. policy + context mgmt .-> C1
    G2 -. instance failure = spec defect .-> G1

    classDef built fill:#dcecdc,stroke:#3e7a4e,stroke-width:2px,color:#12301a
    classDef thin fill:#fdf3dc,stroke:#c08a2d,stroke-width:1.5px,color:#4a3306
    classDef stub fill:#ececec,stroke:#777777,stroke-dasharray: 4 3,color:#2b2b2b
    classDef gate fill:#e8e8f5,stroke:#5a5a99,color:#1f1f4d
